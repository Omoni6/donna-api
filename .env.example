# ============================================
# 🔐 OMONI PLATFORM - CONFIGURATION ENVIRONNEMENT
# ============================================
# Configuration principale pour l'architecture Omoni
# ⚠️  ATTENTION: Ne jamais commiter ce fichier dans Git
# ============================================

# 🌍 CONFIGURATION GÉNÉRALE
# ============================================
APP_NAME=Donna API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# 🔐 SÉCURITÉ
# ============================================
SECRET_KEY=votre-secret-key-tres-long-et-aleatoire-minimum-32-caracteres
API_KEY=donna-api-key-production
JWT_SECRET=jwt-secret-key-minimum-32-caracteres

# 🗄️ BASE DE DONNÉES
# ============================================
DATABASE_URL=sqlite:///./omoni.db
# Pour PostgreSQL: postgresql://user:password@localhost:5432/donna_db

# 🤖 TELEGRAM - CONFIGURATION PRINCIPALE
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_USERNAME=@YourBotUsername
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/telegram

# 🔑 TELEGRAM CORE API (MTProto) - POUR CRÉATION DE CANAUX
# ============================================
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash

# 📱 TELEGRAM - CANAUX ET GROUPES
# ============================================
TELEGRAM_CHAT_ID=-1002491351825
TELEGRAM_CHAT_ID_ALERTS=-4832915059
TELEGRAM_CHAT_ID_SYSTEM=-4919674767
TELEGRAM_CHAT_ID_TEAM=-4907447424
TELEGRAM_CHAT_ID_REPORTS=-4964733758
TELEGRAM_CHAT_ID_MARKETING=-4964733758
TELEGRAM_AUDIT_CHANNEL_ID=-10002947552752
TELEGRAM_NOTIFICATIONS=true
DEFAULT_TELEGRAM_CHAT_ID=-4832915059

# 💬 SLACK - CONFIGURATION
# ============================================
SLACK_BOT_TOKEN=your-slack-bot-token-here
SLACK_TEAM_ID=your-slack-team-id
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_ID=your-slack-app-id

# 📢 SLACK - CANAUX PRÉCONFIGURÉS
# ============================================
SLACK_CHANNEL_TEAM=C08LA65EX1P
SLACK_CHANNEL_ALERTS=C08NXCH7N59
SLACK_CHANNEL_CRM=C09K9D7KZA6
DEFAULT_SLACK_CHANNEL=general

# 💳 STRIPE - PAIEMENTS
# ============================================
STRIPE_SECRET_KEY=sk_test_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_test_stripe_webhook_secret

# 🔗 SERVICES EXTERNES
# ============================================
DONNA_WORKER_URL=http://donna:8001/api/donna/run

# 🌐 CORS ET SÉCURITÉ
# ============================================
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","https://omoni.app","https://app.omoni.fr","https://dashboard.omoni.fr","https://www.omoni.fr"]
ALLOWED_HOSTS=["*"]

# 📊 LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# 🏢 MULTI-TENANT
# ============================================
TENANT_ID_HEADER=X-Tenant-ID
DEFAULT_TENANT=omoni

# ⚡ RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60

# 📤 UPLOADS
# ============================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

